PORT=3333
MONGODB_URI=mongodb://localhost:27017/ai-interview-coach
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3333
FRONTEND_URL=http://localhost:3000
MONGO_TRANSACTIONS=false
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60
# Only set true when REDIS_URL is provisioned; otherwise login/register 503.
AUTH_RATE_LIMIT_FAIL_CLOSED=false

# Server-only interview evaluation. Blank key uses the heuristic fallback.
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=1
